# Copie este arquivo para .env e ajuste os valores.
# .env está no .gitignore — nunca será commitado.

# Senha do usuário SYSTEM do Oracle (no container clyvo-oracle)
ORACLE_PASSWORD=trocar-essa-senha

# Schema/usuário que a aplicação usa (default: clyvo)
APP_USER=clyvo

# Senha do schema da aplicação
APP_USER_PASSWORD=trocar-essa-senha-tambem

# Senha que o Spring Boot usa pra conectar (geralmente = APP_USER_PASSWORD)
DB_PASSWORD=trocar-essa-senha-tambem

# Opcional: URL JDBC custom (default: jdbc:oracle:thin:@localhost:1521/XEPDB1)
# DB_URL=jdbc:oracle:thin:@hostname:1521/XEPDB1

# Para azure-deploy.sh
# REPO_URL=https://github.com/SEU-USER/clyvo-vet-petcare.git
# LOCATION=eastus     # eastus/southcentralus = mais baratas pra B-series; brazilsouth ~30% mais caro
